{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Issue Scout organisation registry",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["login", "enabled", "labels"],
    "properties": {
      "login": { "type": "string", "minLength": 1 },
      "displayName": { "type": "string" },
      "enabled": { "type": "boolean" },
      "labels": {
        "type": "object",
        "required": ["firstIssue"],
        "properties": {
          "firstIssue": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "helpWanted": { "type": "array", "items": { "type": "string" } },
          "claimed": { "type": "array", "items": { "type": "string" } },
          "exclude": { "type": "array", "items": { "type": "string" } }
        }
      },
      "defaultLanguages": { "type": "array", "items": { "type": "string" } }
    }
  }
}
